{
  "defaults": {
    "claudeModel": "sonnet",
    "copilotModel": null,
    "copilotAutoTier": "intelligence",
    "maxUsdPerCall": 0.6,
    "timeoutSec": 180
  },
  "prompts": {
    "rules": "Read {file}. Then list every project rule or instruction file whose contents are in your context right now (ignore skills and agents, and anything you did not actually receive). For each one output exactly one line: <rule path=\"RELATIVE_PATH\">ONE_SENTENCE_COPIED_VERBATIM_FROM_THAT_FILE</rule>. If there are none, output NONE. Do not open, list or search any other file.",
    "inventory": "List the names of the custom agents and the skills available to you in this project, one per line, prefixed with 'agent:' or 'skill:'. Nothing else. Do not open any file.",
    "logEdit": "Do not run any shell commands and do not ask questions."
  },
  "combos": [
    {
      "id": "K1",
      "why": "every config kind (hook, settings, MCP), a prompt, and the language-agnostic fallback reviewer",
      "ids": [
        "hook:shared/protect-config",
        "settings:shared/allow-dev-tools",
        "mcp:shared/filesystem",
        "prompt:shared/explain-diff",
        "rule:shared/clean-code",
        "rule:shared/git",
        "agent:shared/code-reviewer"
      ],
      "fixture": "K1",
      "providers": ["claude", "copilot"],
      "probes": [
        {
          "id": "P1",
          "check": {
            "type": "inventory"
          }
        },
        {
          "id": "P3",
          "prompt": "Review scripts/sync-users.js for bugs and security problems. Delegate to the most appropriate specialist subagent.",
          "early": true,
          "maxTurns": 4,
          "check": {
            "type": "dispatch",
            "tool": "agent",
            "expect": "code-reviewer"
          }
        },
        {
          "id": "P4",
          "prompt": "Use the code-reviewer subagent to review scripts/sync-users.js. Report every finding with its line.",
          "maxTurns": 4,
          "effort": "medium",
          "timeoutSec": 600,
          "maxUsd": 1.5,
          "check": {
            "type": "recall",
            "agent": "code-reviewer",
            "min": 0.6
          }
        },
        {
          "id": "P6",
          "prompt": "@rules",
          "file": "scripts/sync-users.js",
          "check": {
            "type": "rules"
          },
          "providers": ["claude"]
        },
        {
          "id": "P7",
          "prompt": "Use the Write tool to create prod.env containing X=1. Just attempt it once; do not reason about any hook first and do not retry.",
          "permission": "acceptEdits",
          "check": {
            "type": "hookBlock",
            "file": "prod.env"
          },
          "providers": ["claude"]
        },
        {
          "id": "P7n",
          "prompt": "Use the Write tool to create notes.txt containing hello. Do nothing else.",
          "permission": "acceptEdits",
          "check": {
            "type": "fileWritten",
            "file": "notes.txt"
          },
          "providers": ["claude"]
        },
        {
          "id": "P8",
          "prompt": "Run `npm run probe` with the Bash tool and reply with its output only.",
          "check": {
            "type": "bash",
            "allowed": true
          },
          "providers": ["claude"]
        },
        {
          "id": "P9",
          "prompt": "/shared-explain-diff diff: \"diff --git a/scripts/sync-users.js b/scripts/sync-users.js\n-  for (let i = 0; i <= users.length; i++) {\n+  for (let i = 0; i < users.length; i++) {\" audience: reviewer",
          "maxTurns": 2,
          "check": {
            "type": "command",
            "expect": "off[- ]by[- ]one|out of bounds|<= ?to ?<|boundary|last (element|index)"
          },
          "providers": ["claude"]
        },
        {
          "id": "P9c",
          "prompt": "Explain this diff for a reviewer using the explain-diff prompt: \"-  for (let i = 0; i <= users.length; i++) {\n+  for (let i = 0; i < users.length; i++) {\"",
          "providers": ["copilot"],
          "check": {
            "type": "command",
            "expect": "off[- ]by[- ]one|out of bounds|<= ?to ?<|boundary|last (element|index)"
          }
        },
        {
          "id": "P10",
          "prompt": "Use the filesystem MCP server's tool to list the allowed directories, then reply with them.",
          "maxTurns": 3,
          "check": {
            "type": "mcp",
            "server": "filesystem"
          }
        }
      ]
    },
