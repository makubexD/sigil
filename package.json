{
  "name": "sigil",
  "version": "0.1.0",
  "type": "commonjs",
  "description": "Vendor-neutral AI skills, agents, rules, and prompts — compiled to Claude Code, GitHub Copilot, and more.",
  "keywords": [
    "ai",
    "skills",
    "agents",
    "catalog",
    "claude",
    "copilot",
    "mcp",
    "rules",
    "prompts"
  ],
  "author": "makudev1719",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makubexD/sigil.git"
  },
  "homepage": "https://github.com/makubexD/sigil#readme",
  "bugs": {
    "url": "https://github.com/makubexD/sigil/issues"
  },
  "bin": {
    "sigil": "./dist-cli/cli.js"
  },
  "main": "./dist-cli/index.js",
  "types": "./dist-cli/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-cli/index.d.ts",
      "require": "./dist-cli/index.js",
      "default": "./dist-cli/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "catalog/",
    "schema/",
    "dist-cli/",
    "packs.yaml",
    "docs/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist-cli',{recursive:true,force:true});fs.rmSync('test-compiled',{recursive:true,force:true})\"",
    "build": "npm run clean && cross-env NODE_OPTIONS=--max-old-space-size=8192 tsc -p tsconfig.build.json && node dist-cli/schema/emit.js && node dist-cli/targets/emit-capability-doc.js && node dist-cli/emit-catalog-readme.js",
    "build:watch": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsc -p tsconfig.build.json --watch",
    "build:test": "tsc -p tsconfig.test.json",
    "pretest": "npm run build && npm run build:test",
    "test": "node scripts/run-tests.cjs",
    "test:built": "npm run build:test && node scripts/run-tests.cjs",
    "snapshot:update": "npm run build && npm run build:test && cross-env SIGIL_SNAPSHOT_UPDATE=1 node --test test-compiled/targets/output-snapshot.test.js",
    "validate": "node dist-cli/cli.js validate",
    "catalog:build": "node dist-cli/cli.js build",
    "validate:claude-plugins": "node scripts/validate-claude-plugins.cjs",
    "sigil": "node dist-cli/cli.js",
    "prepack": "npm run build",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-doc-comments": "node scripts/check-doc-comments.cjs",
    "check": "npm run lint && npm run format:check && npm run check-doc-comments && npm test",
    "ci:local": "npm audit --omit=dev &&npm run lint && npm run format:check && npm run build && npm run validate && node dist-cli/cli.js sync --check && npm run test:built && npm run catalog:build && npm run validate:claude-plugins && node dist-cli/cli.js --version && node dist-cli/cli.js list"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "commander": "^14.0.3",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.17",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.62.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "config": {
    "claudeCodeVersion": "2.1.288"
  },
  "overrides": {
    "gray-matter": {
      "js-yaml": {
        "argparse": "^2.0.1"
      }
    }
  }
}
