  "author": {
    "name": "Sigil",
    "url": "https://github.com/makubexD/sigil#readme"
  },
  "license": "MIT",
  "keywords": [],
  "userConfig": {
    "ADO_ORG": {
      "type": "string",
      "title": "Azure DevOps organization",
      "description": "The <org> in dev.azure.com/<org>",
      "required": true
    }
  }
}
