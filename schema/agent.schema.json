{
  "$ref": "#/definitions/agent-frontmatter",
  "definitions": {
    "agent-frontmatter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\/[a-z0-9]+(?:-[a-z0-9]+)*){1,2}$"
        },
        "kind": {
          "type": "string",
          "const": "agent"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deprecated": {
          "type": "object",
          "properties": {
            "since": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "supersededBy": {
              "type": "string"
            }
          },
          "required": [
            "since",
            "reason"
          ],
          "additionalProperties": false
        },
        "template": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "language": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disallowedTools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claude": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "enum": [
                "haiku",
                "sonnet",
                "opus"
              ]
            },
            "effort": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "maxTurns": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "isolation": {
              "type": "string",
              "enum": [
                "worktree"
              ]
            },
            "skills": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "relatedArtifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "relation": {
                "type": "string",
                "enum": [
                  "escalates-to",
                  "complements",
                  "see-also"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "relation",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "description",
        "name"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
