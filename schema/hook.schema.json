{
  "$ref": "#/definitions/hook-frontmatter",
  "definitions": {
    "hook-frontmatter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\/[a-z0-9]+(?:-[a-z0-9]+)*){1,2}$"
        },
        "kind": {
          "type": "string",
          "const": "hook"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deprecated": {
          "type": "object",
          "properties": {
            "since": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "supersededBy": {
              "type": "string"
            }
          },
          "required": [
            "since",
            "reason"
          ],
          "additionalProperties": false
        },
        "language": {
          "type": "string"
        },
        "defaultScope": {
          "type": "string",
          "enum": [
            "project",
            "local",
            "user"
          ]
        },
        "event": {
          "type": "string",
          "enum": [
            "before-tool",
            "after-tool",
            "prompt-submit",
            "session-start",
            "stop",
            "subagent-stop",
            "notification",
            "PreToolUse",
            "PostToolUse",
            "UserPromptSubmit",
            "SessionStart",
            "Stop",
            "SubagentStop",
            "Notification"
          ]
        },
        "matcher": {
          "default": "*",
          "type": "string"
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeout": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "description",
        "event"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
