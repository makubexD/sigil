{
  "$ref": "#/definitions/hook-frontmatter",
  "definitions": {
    "hook-frontmatter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "const": "hook"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "version": {
          "type": "string"
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "language": {
          "type": "string"
        },
        "defaultScope": {
          "type": "string",
          "enum": [
            "project",
            "local",
            "user"
          ]
        },
        "event": {
          "type": "string",
          "enum": [
            "PreToolUse",
            "PostToolUse",
            "UserPromptSubmit",
            "SubagentStop",
            "Stop",
            "SessionStart",
            "Notification"
          ]
        },
        "matcher": {
          "type": "string",
          "default": "*"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "timeout": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "description",
        "event",
        "command"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
