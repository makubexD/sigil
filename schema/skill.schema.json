{
  "$ref": "#/definitions/skill-frontmatter",
  "definitions": {
    "skill-frontmatter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "const": "skill"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "version": {
          "type": "string"
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deprecated": {
          "type": "object",
          "properties": {
            "since": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "supersededBy": {
              "type": "string"
            }
          },
          "required": [
            "since",
            "reason"
          ],
          "additionalProperties": false
        },
        "template": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "uses": {
          "type": "object",
          "properties": {
            "rules": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "agents": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "allowedTools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "argumentHint": {
          "type": "string"
        },
        "disableModelInvocation": {
          "type": "boolean"
        },
        "whenToUse": {
          "type": "string"
        },
        "userInvocable": {
          "type": "boolean"
        },
        "skillContext": {
          "type": "string",
          "enum": [
            "fork"
          ]
        },
        "relatedArtifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "relation": {
                "type": "string",
                "enum": [
                  "escalates-to",
                  "complements",
                  "see-also"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "relation",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "description",
        "name",
        "language"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
