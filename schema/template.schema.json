{
  "$ref": "#/definitions/template-frontmatter",
  "definitions": {
    "template-frontmatter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "const": "template"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deprecated": {
          "type": "object",
          "properties": {
            "since": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "supersededBy": {
              "type": "string"
            }
          },
          "required": [
            "since",
            "reason"
          ],
          "additionalProperties": false
        },
        "appliesToKind": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "renamedFrom": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "required",
              "description"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "docs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "verifiedOn": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "covers": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "url",
              "verifiedOn",
              "covers"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "description",
        "appliesToKind",
        "revision",
        "slots",
        "docs"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
